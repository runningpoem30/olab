ELASTICSEARCH_INDEX=emails
WORKER_CONCURRENCY=10
MIN_SEND_INTERVAL_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
